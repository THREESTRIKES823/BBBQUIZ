<Window x:Class="BBBQuiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBB-Quiz"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Hintergrund}">

    <!-- Hinweis: In dieser Datei steht KEINE Farbe und KEINE Schrift direkt.
         Alles kommt aus Design.xaml. Das ist Absicht.
         So aendert man das Aussehen an einer Stelle. -->

    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Kopfzeile -->
            <RowDefinition Height="Auto"/>   <!-- 1: Fragetext -->
            <RowDefinition Height="*"/>      <!-- 2: Antworten -->
            <RowDefinition Height="Auto"/>   <!-- 3: Erklaerung -->
            <RowDefinition Height="Auto"/>   <!-- 4: Fusszeile -->
        </Grid.RowDefinitions>


        <!-- ===== KOPFZEILE: Logo links, Punkte rechts ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Platzhalter fuer das Logo.
                 Sobald Bilder/logo.png existiert, diesen TextBlock
                 durch das Image darunter ersetzen. -->
            <TextBlock Grid.Column="0"
                       x:Name="txtLogoPlatzhalter"
                       Text="BBB-QUIZ"
                       FontFamily="{StaticResource Hausschrift}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource Primaer}"
                       VerticalAlignment="Center"/>

            <!-- <Image Grid.Column="0" Source="/Bilder/logo.png"
                    Height="48" HorizontalAlignment="Left"/> -->

            <TextBlock Grid.Column="1"
                       x:Name="txtPunkte"
                       Text="0 Punkte"
                       FontFamily="{StaticResource Hausschrift}"
                       FontSize="18"
                       Foreground="{StaticResource Textfarbe}"
                       VerticalAlignment="Center"/>
        </Grid>


        <!-- ===== FRAGETEXT ===== -->
        <TextBlock Grid.Row="1"
                   x:Name="txtFrage"
                   Text="Frage wird geladen..."
                   Style="{StaticResource FrageText}"/>


        <!-- ===== ANTWORT-KNOEPFE ===== -->
        <StackPanel Grid.Row="2" x:Name="panelAntworten" VerticalAlignment="Top">
            <Button x:Name="btnA" Style="{StaticResource AntwortKnopf}" Click="Antwort_Click" Tag="0"/>
            <Button x:Name="btnB" Style="{StaticResource AntwortKnopf}" Click="Antwort_Click" Tag="1"/>
            <Button x:Name="btnC" Style="{StaticResource AntwortKnopf}" Click="Antwort_Click" Tag="2"/>
            <Button x:Name="btnD" Style="{StaticResource AntwortKnopf}" Click="Antwort_Click" Tag="3"/>
        </StackPanel>


        <!-- ===== ERKLAERUNG (erscheint nach der Antwort) ===== -->
        <TextBlock Grid.Row="3"
                   x:Name="txtErklaerung"
                   Style="{StaticResource NormalText}"
                   Margin="0,16,0,0"
                   Visibility="Collapsed"/>


        <!-- ===== FUSSZEILE ===== -->
        <TextBlock Grid.Row="4"
                   x:Name="txtFortschritt"
                   Text=""
                   Style="{StaticResource NormalText}"
                   Opacity="0.6"
                   HorizontalAlignment="Center"
                   Margin="0,24,0,0"/>
    </Grid>
</Window>
